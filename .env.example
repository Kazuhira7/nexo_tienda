# Copia este archivo a .env.local y rellena los valores reales.
# Las llaves están en Supabase > Project Settings > API.
# NUNCA subas .env.local a GitHub (la service_role key es secreta).

# URL del proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=

# anon key — segura para el navegador (protegida por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key — SOLO servidor, jamás llega al cliente
SUPABASE_SERVICE_ROLE_KEY=
